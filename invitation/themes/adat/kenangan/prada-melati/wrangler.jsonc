{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rimba-prada-melati",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "prada-melati.rimba.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_THEMES_CDN": "https://assets-themes.rimba.io",
    "NEXT_PUBLIC_PHOTOS_CDN": "https://assets-invitations.rimba.io",
    // Go API the theme fetches invitation content from when the wildcard
    // router forwards a request with an x-rimba-slug header.
    "API_URL": "https://api.rimba.io"
  }
}
